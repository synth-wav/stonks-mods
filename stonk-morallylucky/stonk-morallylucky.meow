-- Morally Lucky (stonk-morallylucky)
--
-- A normative-ethics mod. Random dilemmas ask what you ought to do, and every
-- option is a stance one of three theories would defend:
--   VE   virtue ethics       (Aristotle, Confucius, the Stoics, Foot)
--   UTL  consequentialism    (Bentham, Mill, Godwin, Singer)
--   DNT  deontology          (Kant, Ross, Socrates in the Crito)
-- Each choice has an immediate effect and a delayed consequence that luck
-- decides. The gap between the two is "moral luck" (Nagel, Williams, 1976).
--
-- Reach 5 choices in a school and its great figures start to appear: one
-- great reward, one dire ordeal and one where your choice decides, per school.
--
-- Content: mature themes (crime, violence, drunk driving, infidelity,
-- assisted dying, child labour). Outcomes can be catastrophic: jail,
-- hospital, ruinous losses, company collapses and market-wide crashes.
--
--   F7         force a dilemma (or an unlocked encounter) now
--   Ctrl+F7    force an encounter with a great figure, if one is unlocked
--   Shift+F7   show your moral ledger
--
-- Catspeak notes: no closures over `let` locals, so a dilemma's context lives
-- in mod.cur and is passed to each option as a parameter. Dialog buttons and
-- delayed consequences call functions registered by name ("morallylucky.*").
-- Text rules: no square brackets (Scribble markup), no angle brackets or
-- curly braces (the dialog substitutes variables there), and no \" escapes
-- (Catspeak doesn't support them; use single quotes).

-- Tuning ---------------------------------------------------------------------

ML_CHANCE = 5            -- % chance per day once the cooldown has passed
ML_COOLDOWN = 14         -- minimum days between dilemmas
ML_FIRST_DAY = 10        -- no dilemmas before this game day
ML_PROFILE_EVERY = 3     -- show the moral ledger after every N choices
ML_UNLOCK = 5            -- choices in a school needed to meet its figures
ML_ENCOUNTER_CHANCE = 40 -- % of triggers that become an encounter, if one is unlocked
ML_TITLE = "Morally Lucky"

-- Schools --------------------------------------------------------------------

ML_SCHOOLS = ["ve", "utl", "dnt"]

ML_SCHOOL_NAME = {
  ve: "Virtue ethics (VE)",
  utl: "Consequentialism (UTL)",
  dnt: "Deontology (DNT)"
}

ML_SCHOOL_VOICE = {
  ve: "You keep asking what a good person would do, not which rule applies or which sum comes out highest. Aristotle called that practical wisdom: the mean between too much and too little, found case by case.",
  utl: "You keep counting. Every choice weighs the welfare of everyone it touches, yours included and no more than anyone else's. Bentham would approve of the arithmetic; Mill would ask whether the pleasures were the higher kind.",
  dnt: "You keep acting on principle: some things are owed and some are forbidden, whatever the payoff. Kant would say you act from duty and treat people as ends, never merely as means, even when it costs you. Especially then."
}

ML_SCHOOL_UNLOCK = {
  ve: "Your choices have the shape of a character now. Somewhere, a man who taught Alexander the Great has heard of you.",
  utl: "Your ledger of welfare is getting long. In a London museum, a preserved philosopher in a glass box seems to lean forward.",
  dnt: "You've kept faith with duty five times now. In Konigsberg, someone checks his watch and nods."
}

-- Small helpers --------------------------------------------------------------

ml_text = fun (parts) {
  let s = ""
  let i = 0
  while (i < array_length(parts)) {
    s += parts[i]
    i += 1
  }
  return s
}

ml_ctl = fun () {
  return instance_find(o_control, 0)
}

ml_roll = fun (pct) {
  return irandom(99) < pct
}

-- Money scaled to the player's wealth, so dilemmas stay meaningful all game.
ml_amt = fun (pct) {
  return money_round(max(money_event_wealth() * pct, 100000))
}

ml_cash = fun (x) {
  return string_thousands(x)
}

ml_gain = fun (x) {
  if (x > 0) {
    money_add(x)
  }
}

ml_lose = fun (x) {
  if (x > 0) {
    money_delete(x)
  }
}

ml_rep = fun (stat, d) {
  -- 0 public image, 1 financial success, 2 ethical conduct, 3 networking,
  -- 4 market knowledge, 5 philanthropy, 6 innovation
  if (d != 0) {
    change_char(d, stat)
  }
}

ml_all_reps = fun (d) {
  let i = 0
  while (i < 7) {
    ml_rep(i, d)
    i += 1
  }
}

ml_stress = fun (d) {
  global.stress = clamp(global.stress + d, 0, 100)
}

ml_happy = fun (d) {
  global.happy = clamp(global.happy + d, 0, 100)
}

ml_jail = fun (days) {
  let ctl = ml_ctl()
  ctl.srok = days
  global.turma = 1
}

ml_hospital = fun () {
  global.hospital = 1
  global.stress = 100
}

-- Market-wide shock, using the same lever as the game's own crashes and booms.
ml_market = fun (factor) {
  global.trend_target = global.trend_target * factor
}

ml_friend = fun (h, d) {
  if (h > 0) {
    change_friend(d, h)
  }
}

ml_note = fun (title, text) {
  create_notification(title, text)
}

ml_live_companies = fun () {
  let out = []
  let i = 0
  while (i < global.numberofcompany) {
    if (birza_slot_is_live(i) and i != global.player_compnumber) {
      array_push(out, i)
    }
    i += 1
  }
  return out
}

ml_random_company = fun () {
  let list = ml_live_companies()
  if (array_length(list) == 0) {
    return -1
  }
  return list[irandom(array_length(list) - 1)]
}

ml_company_ok = fun (slot, name) {
  if (slot < 0 or slot >= global.numberofcompany) {
    return false
  }
  return birza_slot_is_live(slot) and global.company_name[slot] == name
}

ml_hype = fun (slot, d) {
  global.company_hype[slot] = global.company_hype[slot] + d
  global.company_hype_effect[slot] = clamp(round(d * 30), -25, 25)
}

ml_price = fun (slot, factor) {
  global.company_price[slot] = global.company_price[slot] * factor
}

ml_random_contact = fun () {
  let list = find_contacts()
  if (!is_array(list) or array_length(list) == 0) {
    return 0
  }
  return list[irandom(array_length(list) - 1)]
}

ml_name = fun (h) {
  if (h > 0) {
    return get_fullname(h)
  }
  return "an old friend"
}

-- Schedule a delayed consequence. Arguments must be plain numbers/strings:
-- they are stored in the save file until the day arrives.
ml_later = fun (days, id, key, a0, a1, a2, a3) {
  delay_action(days, "morallylucky.outcome", id, key, a0, a1, a2, a3)
}

-- Dilemmas -------------------------------------------------------------------
-- id, title, can(), setup() -> ctx, text(ctx), options[] with
-- { label, school, run(ctx) }, outcomes { key: fun (a0, a1, a2, a3) }.
-- Every option is tagged ve, utl or dnt.

ML_DILEMMAS = [

  -- 1. The trolley problem (Foot 1967, Thomson 1976) ---------------------------
  {
    id: "trolley",
    title: "The Trolley Desk",
    can: fun () {
      return ml_random_company() >= 0
    },
    setup: fun () {
      let co = ml_random_company()
      return { co: co, co_name: global.company_name[co], human: 0, cost: ml_amt(0.12) }
    },
    text: fun (c) {
      return ml_text([
        "3:12 a.m. A runaway sell algorithm is about to dump ", c.co_name, " and drag five small pension funds down with it. ",
        "One keystroke reroutes the losses into a single account: a retired schoolteacher's life savings. Or you can cover the hole yourself: ", ml_cash(c.cost), ".",
        "\n\nUTL: five ruined families are worse than one. DNT: rerouting makes you the one who ruins her; allowing harm isn't doing it. VE: what would a just and generous person do with a fortune and a cursor?"
      ])
    },
    options: [
      {
        label: "UTL: Reroute, save five",
        school: "utl",
        run: fun (c) {
          ml_stress(10)
          ml_later(irandom_range(3, 6), "trolley", "rerouted", 0, 0, 0, 0)
        }
      },
      {
        label: "DNT: Don't redirect harm",
        school: "dnt",
        run: fun (c) {
          ml_price(c.co, 0.85)
          ml_hype(c.co, -0.4)
          ml_later(irandom_range(3, 6), "trolley", "untouched", 0, 0, 0, 0)
        }
      },
      {
        label: "VE: Cover it yourself",
        school: "ve",
        run: fun (c) {
          ml_lose(c.cost)
          ml_rep(2, 3)
          ml_rep(0, 2)
          ml_note(ML_TITLE, "You covered the shortfall from your own account: " + ml_cash(c.cost) + ". Nobody's pension was touched.")
          ml_later(irandom_range(5, 10), "trolley", "absorbed", 0, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      rerouted: fun (a0, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_rep(2, -2)
          ml_rep(4, 2)
          ml_note(ML_TITLE, "The five funds survived. The schoolteacher's story went viral anyway. The sum came out the way Bentham said it would. It just has a face now.")
        } else {
          ml_lose(ml_amt(0.08))
          ml_rep(2, -3)
          ml_stress(25)
          ml_note(ML_TITLE, "The reroute misfired and all six accounts were wiped. Regulators want to know who pressed the key. The calculation was right. The code wasn't.")
        }
      },
      untouched: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_stress(10)
          ml_rep(2, 1)
          ml_note(ML_TITLE, "The five funds collapsed. You didn't redirect the harm, and you didn't stop it. The deontologist's line between doing and allowing held. The pensioners are on the wrong side of it.")
        } else {
          ml_rep(2, 2)
          ml_rep(0, 1)
          ml_note(ML_TITLE, "A market-maker absorbed the selloff before it reached the funds. You kept your hands off the lever, and luck kept everyone whole.")
        }
      },
      absorbed: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_happy(20)
          ml_note(ML_TITLE, "A handwritten letter arrives from the schoolteacher, who found out somehow. Aristotle said virtue is its own reward. Sometimes it also gets mail.")
        } else {
          ml_happy(5)
          ml_note(ML_TITLE, "Nobody ever finds out what you did. Aristotle said virtue is its own reward. Lucky, since it's the only one you got.")
        }
      }
    }
  },

  -- 2. Plato, Republic II: the Ring of Gyges ----------------------------------
  {
    id: "gyges",
    title: "The Ring of Gyges",
    can: fun () {
      return ml_random_company() >= 0
    },
    setup: fun () {
      let co = ml_random_company()
      return { co: co, co_name: global.company_name[co], human: 0 }
    },
    text: fun (c) {
      return ml_text([
        "An engineer at ", c.co_name, " slips you an untraceable backdoor into the order book of every fund that trades it. With it you could prove what everyone suspects: a cartel is rigging the market. Using it is a crime.",
        "\n\nUTL: expose the riggers, whatever the means. DNT: report the leak; illegal access is wrong even for a good cause. VE: Plato's just man doesn't need a rule. He just doesn't put the ring on."
      ])
    },
    options: [
      {
        label: "UTL: Use it to expose them",
        school: "utl",
        run: fun (c) {
          ml_rep(4, 2)
          ml_later(irandom_range(10, 25), "gyges", "used", 0, 0, 0, 0)
        }
      },
      {
        label: "DNT: Report the backdoor",
        school: "dnt",
        run: fun (c) {
          ml_rep(2, 2)
          ml_rep(3, -1)
          ml_later(irandom_range(5, 12), "gyges", "reported", 0, 0, 0, 0)
        }
      },
      {
        label: "VE: Destroy it unread",
        school: "ve",
        run: fun (c) {
          ml_happy(5)
          ml_later(irandom_range(8, 15), "gyges", "destroyed", 0, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      used: fun (a0, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_rep(0, 3)
          ml_market(1.15)
          ml_gain(ml_amt(0.1))
          ml_note("News", "An anonymous dossier exposes a market-rigging cartel. Arrests follow, the market rallies, and an anonymous tip pays out. Good outcome, illegal means. The consequentialist sleeps fine.")
        } else {
          ml_lose(ml_amt(0.2))
          ml_rep(0, -5)
          ml_rep(2, -5)
          ml_jail(150)
          ml_note("Court", "The backdoor was a honeypot. The cartel walks; you get five months for unauthorised access. The greater good needed a better plan.")
        }
      },
      reported: fun (a0, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_rep(0, 2)
          ml_gain(ml_amt(0.03))
          ml_note(ML_TITLE, "Regulators thank you publicly and pay a whistleblower bounty. Duty and fortune, for once, point the same way.")
        } else {
          ml_rep(3, -3)
          ml_stress(15)
          ml_note(ML_TITLE, "Your name leaked as the one who turned the engineer in, and the cartel keeps rigging. You did what was right. It didn't come with friends.")
        }
      },
      destroyed: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_market(0.85)
          ml_note(ML_TITLE, "The engineer sold the backdoor to someone with fewer scruples, and the market wobbles as the rigging spreads. Your character stayed clean. The water still got dirty.")
        } else {
          ml_note(ML_TITLE, "Nothing more comes of the backdoor. That's the hard part of the ring: nobody sees what you didn't do. Plato thought that was exactly the point.")
        }
      }
    }
  },

  -- 3. Drug pricing: access, contracts and justice ------------------------------
  {
    id: "cure",
    title: "The Price of a Cure",
    can: fun () {
      return true
    },
    setup: fun () {
      return { human: 0, stake: ml_amt(0.15) }
    },
    text: fun (c) {
      return ml_text([
        "A biotech you backed with ", ml_cash(c.stake), " has a cure for a rare childhood disease. The board wants your vote on the price.",
        " You promised your co-investors maximum return. At that price, most families can't pay.",
        "\n\nUTL: tiered pricing, rich countries pay more, so the most children get treated. DNT: you made a promise to your investors and you keep it. VE: a just and generous person takes a fair profit and no more."
      ])
    },
    options: [
      {
        label: "UTL: Tiered pricing",
        school: "utl",
        run: fun (c) {
          ml_rep(5, 2)
          ml_later(irandom_range(15, 30), "cure", "tiered", c.stake, 0, 0, 0)
        }
      },
      {
        label: "DNT: Keep your promise",
        school: "dnt",
        run: fun (c) {
          ml_rep(1, 2)
          ml_later(irandom_range(15, 30), "cure", "promise", c.stake, 0, 0, 0)
        }
      },
      {
        label: "VE: A fair price",
        school: "ve",
        run: fun (c) {
          ml_rep(2, 2)
          ml_rep(0, 2)
          ml_later(irandom_range(15, 30), "cure", "fair", c.stake, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      tiered: fun (stake, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_gain(stake * 1.5)
          ml_rep(5, 3)
          ml_note("News", "The cure reaches forty countries. Rich health systems pay a premium, poor ones pay cost, and the company still turns a profit. Singer cites it as a model.")
        } else {
          ml_lose(ml_amt(0.05))
          ml_rep(1, -2)
          ml_note("News", "Grey-market traders buy the cheap doses abroad and resell them in rich countries. Revenue collapses. Good arithmetic, but it couldn't account for smugglers.")
        }
      },
      promise: fun (stake, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_gain(stake * 3)
          ml_rep(3, 2)
          ml_note(ML_TITLE, "The investors get exactly what you promised: a fortune. You kept your word. Kant would say that's what matters. Most of the children don't get the drug.")
        } else {
          ml_gain(stake)
          ml_rep(0, -6)
          ml_stress(20)
          ml_note("News", "A senate hearing on cure profiteering puts your face on every channel. The investors are happy. Nobody else is. Keeping a promise doesn't mean the promise was a good one to make.")
        }
      },
      fair: fun (stake, a1, a2, a3) {
        if (ml_roll(70)) {
          ml_gain(stake * 1.2)
          ml_happy(15)
          ml_note(ML_TITLE, "A modest profit, a lot of treated children, and the satisfaction Aristotle said comes from acting well. The investors grumble, then quietly brag about it at parties.")
        } else {
          ml_lose(ml_amt(0.1))
          ml_rep(3, -2)
          ml_note("Court", "Your co-investors sue for breach of fiduciary duty and win a settlement. A fair price turns out to be very expensive.")
        }
      }
    }
  },

  -- 4. Singer, "Famine, Affluence, and Morality" (1972) ------------------------
  {
    id: "drowning",
    title: "The Drowning Child",
    can: fun () {
      return ml_random_contact() > 0
    },
    setup: fun () {
      let h = ml_random_contact()
      return { human: h, who: ml_name(h), tithe: ml_amt(0.1), hurt: ml_amt(0.4), bonus: ml_amt(0.08) }
    },
    text: fun (c) {
      return ml_text([
        c.who, " calls about a famine appeal that closes tonight. 'You'd ruin your suit to pull a drowning child out of a pond,' they say, quoting Peter Singer. 'This pond is just farther away.'",
        " But you've already promised your staff a bonus pool of ", ml_cash(c.bonus), ".",
        "\n\nUTL: give until it hurts, ", ml_cash(c.hurt), ". DNT: a promise is a promise; the bonus goes to your staff. VE: generosity is a mean between stinginess and recklessness: a tithe, ", ml_cash(c.tithe), "."
      ])
    },
    options: [
      {
        label: "UTL: Give until it hurts",
        school: "utl",
        run: fun (c) {
          ml_lose(c.hurt)
          ml_rep(5, 5)
          ml_rep(0, 3)
          ml_friend(c.human, 20)
          ml_later(irandom_range(10, 20), "drowning", "hurt", 0, 0, 0, 0)
        }
      },
      {
        label: "DNT: Pay the promised bonus",
        school: "dnt",
        run: fun (c) {
          ml_lose(c.bonus)
          ml_rep(3, 2)
          ml_friend(c.human, -10)
          ml_later(irandom_range(10, 20), "drowning", "bonus", 0, 0, 0, 0)
        }
      },
      {
        label: "VE: Give a tithe",
        school: "ve",
        run: fun (c) {
          ml_lose(c.tithe)
          ml_rep(5, 2)
          ml_friend(c.human, 10)
          ml_later(irandom_range(10, 20), "drowning", "tithe", 0, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      hurt: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_rep(0, 3)
          ml_happy(15)
          ml_note(ML_TITLE, "Singer mentions an anonymous donor in a lecture. Everyone knows it's you. For once the papers call a trader a hero.")
        } else {
          ml_rep(1, -3)
          ml_stress(15)
          ml_note(ML_TITLE, "Your creditors notice the hole in your liquidity and tighten your terms. Singer never said saving the child would be free. He just said you ought to.")
        }
      },
      bonus: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_rep(3, 2)
          ml_happy(5)
          ml_note(ML_TITLE, "Your staff hear you chose their bonus over a public gesture. Loyalty runs both ways: two of them turn down poaching offers.")
        } else {
          ml_stress(15)
          ml_note("News", "The famine appeal fell short of its target. The papers run photographs. You kept your promise. Kant says that was your duty. The pictures say other things.")
        }
      },
      tithe: fun (a0, a1, a2, a3) {
        if (ml_roll(80)) {
          ml_rep(0, 2)
          ml_happy(10)
          ml_note(ML_TITLE, "The appeal's report arrives: wells dug, a district fed. Your tithe is a line in a spreadsheet and a few hundred people alive.")
        } else {
          ml_stress(10)
          ml_note(ML_TITLE, "The charity's director has been arrested for embezzlement. Your gift bought a boat. Your act was just as good as it was yesterday. Its outcome wasn't. That's moral luck.")
        }
      }
    }
  },

  -- 5. Promise against the greater good (after Williams' Gauguin) -------------
  {
    id: "gauguin",
    title: "The Promise and the Moonshot",
    can: fun () {
      return ml_random_contact() > 0 and ml_random_company() >= 0
    },
    setup: fun () {
      let h = ml_random_contact()
      let co = ml_random_company()
      return { human: h, who: ml_name(h), co: co, co_name: global.company_name[co], stake: ml_amt(0.3), split: ml_amt(0.12) }
    },
    text: fun (c) {
      return ml_text([
        "Years ago you promised ", c.who, " you'd back their business if it ever got into trouble. It's in trouble. The same week, ", c.co_name, " needs ", ml_cash(c.stake), " to finish a water purifier that could reach millions. You can't fully do both.",
        "\n\nUTL: millions of people outweigh one friend. DNT: you gave your word. VE: practical wisdom: help your friend and back the purifier, half each, and accept that neither gets everything."
      ])
    },
    options: [
      {
        label: "UTL: Back the purifier",
        school: "utl",
        run: fun (c) {
          ml_lose(c.stake)
          ml_friend(c.human, -25)
          ml_later(irandom_range(20, 40), "gauguin", "moonshot", c.stake, c.human, c.co, c.co_name)
        }
      },
      {
        label: "DNT: Keep your promise",
        school: "dnt",
        run: fun (c) {
          ml_lose(ml_amt(0.05))
          ml_friend(c.human, 20)
          ml_later(irandom_range(20, 40), "gauguin", "friend", c.human, 0, 0, 0)
        }
      },
      {
        label: "VE: Split it wisely",
        school: "ve",
        run: fun (c) {
          ml_lose(c.split)
          ml_friend(c.human, 5)
          ml_later(irandom_range(20, 40), "gauguin", "split", c.split, c.human, 0, 0)
        }
      }
    ],
    outcomes: {
      moonshot: fun (stake, h, co, name) {
        if (ml_roll(45)) {
          ml_gain(stake * 5)
          ml_rep(6, 4)
          ml_rep(5, 3)
          if (ml_company_ok(co, name)) {
            ml_hype(co, 0.6)
          }
          ml_note(ML_TITLE, "The purifier ships to forty countries and your stake is worth five times what you paid. Millions drink clean water. " + ml_name(h) + " still doesn't take your calls.")
        } else {
          ml_friend(h, -10)
          ml_rep(2, -2)
          ml_stress(20)
          ml_note(ML_TITLE, "The purifier fails its final trials. You broke a promise for a good bet that lost. Bernard Williams' point: only the outcome could have justified it, and the outcome didn't come.")
        }
      },
      friend: fun (h, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_friend(h, 10)
          ml_rep(3, 2)
          ml_note(ML_TITLE, ml_name(h) + "'s business turns the corner. They'll never forget it. The purifier went ahead without you, slower.")
        } else {
          ml_stress(15)
          ml_note(ML_TITLE, ml_name(h) + "'s business fails anyway. You kept your word and it wasn't enough. Nagel calls this resultant luck: we're judged by outcomes we never controlled.")
        }
      },
      split: fun (split, h, a2, a3) {
        if (ml_roll(55)) {
          ml_gain(split * 2)
          ml_friend(h, 10)
          ml_note(ML_TITLE, "Both survive: your friend's business limps on and the purifier finds a second investor. Neither of them got everything, and both thank you.")
        } else {
          ml_friend(h, -10)
          ml_stress(15)
          ml_note(ML_TITLE, "Half was not enough for either. Both fail. Practical wisdom is a virtue. It is not a guarantee.")
        }
      }
    }
  },

  -- 6. Nagel's two drunk drivers -------------------------------------------------
  {
    id: "drivers",
    title: "The Two Drivers",
    can: fun () {
      return true
    },
    setup: fun () {
      return { human: 0, bills: ml_amt(0.05) }
    },
    text: fun (c) {
      return ml_text([
        "You don't remember the drive home from the bar. This morning's paper: a cyclist was hit on your street around 1 a.m. and the driver kept going. There is a dent in your bumper.",
        "\n\nUTL: quietly pay the cyclist's bills; more good done, no years wasted in a cell. DNT: you may have committed a crime; you owe the truth to the police. VE: courage and honesty, in person: knock on the cyclist's door yourself."
      ])
    },
    options: [
      {
        label: "UTL: Pay bills anonymously",
        school: "utl",
        run: fun (c) {
          ml_lose(c.bills)
          ml_later(irandom_range(6, 14), "drivers", "paid", 0, 0, 0, 0)
        }
      },
      {
        label: "DNT: Go to the police",
        school: "dnt",
        run: fun (c) {
          ml_stress(15)
          ml_later(irandom_range(4, 8), "drivers", "confessed", 0, 0, 0, 0)
        }
      },
      {
        label: "VE: Face the cyclist",
        school: "ve",
        run: fun (c) {
          ml_stress(10)
          ml_later(irandom_range(4, 8), "drivers", "faced", 0, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      paid: fun (a0, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_happy(10)
          ml_rep(5, 2)
          ml_note(ML_TITLE, "The cyclist recovers fully and thanks the mysterious donor on local TV. More good done than a cell would have managed. You'll never know if you were the driver.")
        } else {
          ml_rep(0, -4)
          ml_rep(2, -3)
          ml_jail(180)
          ml_note("Court", "Investigators trace your anonymous payments back to you, and the paint on your bumper matches. Hit-and-run, plus what looks like hush money. Six months.")
        }
      },
      confessed: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_lose(ml_amt(0.03))
          ml_rep(2, 3)
          ml_rep(0, -1)
          ml_note("Court", "Forensics clear you: the dent is from a parking garage. You still confessed to driving drunk, so there's a fine. You were the lucky driver, and you didn't wait to find out.")
        } else {
          ml_lose(ml_amt(0.1))
          ml_rep(0, -4)
          ml_rep(2, 2)
          ml_jail(120)
          ml_note("Court", "The paint matches. You were the driver. The cyclist will walk again. Four months inside, and the judge notes you came forward. Nagel's unlucky driver, but an honest one.")
        }
      },
      faced: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_happy(15)
          ml_rep(2, 3)
          ml_note(ML_TITLE, "The cyclist listens, cries, and decides not to press charges, as long as you never drive drunk again. You won't. Aristotle: we become brave by doing brave things.")
        } else {
          ml_lose(ml_amt(0.05))
          ml_rep(0, -2)
          ml_jail(60)
          ml_note("Court", "The cyclist calls the police while you're still on the doorstep. Two months, reduced for candour. Courage got you here, and it got you a lighter sentence.")
        }
      }
    }
  },

  -- 7. Paying protection: welfare, complicity, courage ---------------------------
  {
    id: "leviathan",
    title: "A Small Leviathan",
    can: fun () {
      return true
    },
    setup: fun () {
      return { human: 0, tribute: ml_amt(0.06) }
    },
    text: fun (c) {
      return ml_text([
        "Two men in very good suits visit your office. For ", ml_cash(c.tribute), " a quarter, nobody sabotages your deals or follows your staff home. They are not asking.",
        "\n\nUTL: pay, and keep everyone safe. DNT: funding a criminal enterprise is wrong, full stop. VE: courage is the mean between cowardice and recklessness: go to the police."
      ])
    },
    options: [
      {
        label: "UTL: Pay to keep staff safe",
        school: "utl",
        run: fun (c) {
          ml_lose(c.tribute)
          ml_rep(3, 2)
          ml_later(irandom_range(15, 30), "leviathan", "paid", 0, 0, 0, 0)
        }
      },
      {
        label: "DNT: Refuse on principle",
        school: "dnt",
        run: fun (c) {
          ml_stress(10)
          ml_later(irandom_range(3, 8), "leviathan", "refused", 0, 0, 0, 0)
        }
      },
      {
        label: "VE: Go to the police",
        school: "ve",
        run: fun (c) {
          ml_rep(2, 2)
          ml_later(irandom_range(5, 12), "leviathan", "police", 0, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      paid: fun (a0, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_market(1.15)
          ml_gain(ml_amt(0.05))
          ml_note(ML_TITLE, "Whatever they do, it works. Nobody gets hurt, your deals close smoothly, and the market feels oddly cooperative. Hobbes would call it peace. Don't ask how it's kept.")
        } else {
          ml_rep(0, -5)
          ml_rep(2, -4)
          ml_jail(90)
          ml_note("Court", "Police raid the organisation. Your quarterly payments are in their ledger, neatly itemised. Three months for financing a criminal enterprise. The safety you bought came with a receipt.")
        }
      },
      refused: fun (a0, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_rep(2, 2)
          ml_note(ML_TITLE, "The men never come back. Maybe you weren't worth the trouble. Your principles cost you nothing this time.")
        } else {
          ml_hospital()
          ml_note("Oh no!", "They came back. You wake up in hospital with two cracked ribs and a get-well card with no name on it. Principles are a duty. They are not body armour.")
        }
      },
      police: fun (a0, a1, a2, a3) {
        let r = irandom(99)
        if (r < 50) {
          ml_rep(0, 4)
          ml_note("News", "Arrests across the city. Your testimony brought down a protection racket. Courage, in a very good suit.")
        } else if (r < 80) {
          ml_note(ML_TITLE, "The police take your statement and nothing happens. Brave, and so far, irrelevant.")
        } else {
          ml_hospital()
          ml_lose(ml_amt(0.1))
          ml_note("Oh no!", "Someone firebombed your office in the night. Records gone, two weeks of recovery ahead. Courage is a virtue. Aristotle never said it was safe.")
        }
      }
    }
  },

  -- 8. Kant's formula of humanity ------------------------------------------------
  {
    id: "kompromat",
    title: "Merely as a Means",
    can: fun () {
      return ml_random_company() >= 0
    },
    setup: fun () {
      let co = ml_random_company()
      return { co: co, co_name: global.company_name[co], human: 0 }
    },
    text: fun (c) {
      return ml_text([
        "You know the CEO of ", c.co_name, " is quietly looting the employee pension fund. You can't prove it. What you do have, from a private investigator, is photos of the CEO's affair.",
        "\n\nUTL: use the photos to force the CEO to stop; thousands of pensions outweigh one person's dignity. DNT: never treat a person merely as a means; burn them and report the fraud properly. VE: be honest and brave: confront the CEO face to face."
      ])
    },
    options: [
      {
        label: "UTL: Leverage the photos",
        school: "utl",
        run: fun (c) {
          ml_later(irandom_range(6, 15), "kompromat", "leverage", c.co, c.co_name, 0, 0)
        }
      },
      {
        label: "DNT: Burn them, report it",
        school: "dnt",
        run: fun (c) {
          ml_rep(2, 2)
          ml_later(irandom_range(10, 20), "kompromat", "reported", c.co, c.co_name, 0, 0)
        }
      },
      {
        label: "VE: Confront the CEO",
        school: "ve",
        run: fun (c) {
          ml_later(irandom_range(5, 10), "kompromat", "confronted", c.co, c.co_name, 0, 0)
        }
      }
    ],
    outcomes: {
      leverage: fun (co, name, a2, a3) {
        if (ml_roll(55)) {
          ml_rep(5, 3)
          ml_gain(ml_amt(0.05))
          ml_note(ML_TITLE, "The CEO quietly refunds the pension fund and resigns 'to spend time with family'. Thousands of retirements saved by one act of blackmail. The arithmetic is unanswerable. The method is not.")
        } else {
          ml_rep(0, -6)
          ml_rep(2, -5)
          ml_jail(60)
          ml_note("Court", "The CEO confessed the affair on live TV and named their blackmailer. Two months for extortion, and the pension fraud never comes up. You used a person as a means, and they used you right back.")
        }
      },
      reported: fun (co, name, a2, a3) {
        if (ml_roll(50)) {
          ml_rep(0, 3)
          ml_rep(3, 2)
          if (ml_company_ok(co, name)) {
            ml_price(co, 0.8)
          }
          ml_note("News", "Regulators open an investigation into " + name + "'s pension fund. The CEO is charged. You never touched the photos. Duty, and slowly, justice.")
        } else {
          ml_stress(15)
          ml_note(ML_TITLE, "The regulator files your report and does nothing. The pensions keep draining. Kant says you did right. The pensioners would like a word with Kant.")
        }
      },
      confronted: fun (co, name, a2, a3) {
        if (ml_roll(50)) {
          ml_rep(3, 3)
          ml_rep(2, 2)
          ml_note(ML_TITLE, "The CEO breaks down, confesses, and repays the fund. People mostly want to be better than they are; sometimes they need someone to ask them to their face.")
        } else {
          ml_rep(0, -3)
          ml_lose(ml_amt(0.05))
          if (ml_company_ok(co, name)) {
            ml_hype(co, 0.3)
          }
          ml_note("Court", "The CEO sues you for defamation and settles out of court for a painful sum. Honesty was the virtuous choice. It wasn't the safe one.")
        }
      }
    }
  },

  -- 9. Le Guin, "The Ones Who Walk Away from Omelas" (1973) --------------------
  {
    id: "omelas",
    title: "The Ones Who Walk Away",
    can: fun () {
      return true
    },
    setup: fun () {
      return { human: 0, divest: ml_amt(0.15) }
    },
    text: fun (c) {
      return ml_text([
        "Your analysts found why the market keeps booming: the supply chain under half the index runs through a factory where children are locked in, sixteen hours a day. Everyone at the top knows.",
        "\n\nUTL: the boom feeds millions of families; one factory's misery is outweighed. DNT: complicity in that is wrong; expose it, whatever happens to the market. VE: Le Guin's answer: walk away, quietly, and refuse to profit."
      ])
    },
    options: [
      {
        label: "UTL: Stay and profit",
        school: "utl",
        run: fun (c) {
          ml_market(1.25)
          ml_gain(ml_amt(0.1))
          ml_rep(2, -4)
          ml_later(irandom_range(20, 40), "omelas", "stayed", 0, 0, 0, 0)
        }
      },
      {
        label: "DNT: Expose it",
        school: "dnt",
        run: fun (c) {
          ml_market(0.4)
          ml_rep(2, 6)
          ml_rep(0, 4)
          ml_rep(5, 2)
          ml_note("News", "MARKET CRASH. Your leak about forced child labour in the supply chain wiped out the boom. Every portfolio in the city is bleeding, including yours.")
          ml_later(irandom_range(20, 35), "omelas", "exposed", 0, 0, 0, 0)
        }
      },
      {
        label: "VE: Walk away",
        school: "ve",
        run: fun (c) {
          ml_lose(c.divest)
          ml_rep(2, 3)
          ml_happy(10)
          ml_note(ML_TITLE, "You divest at a loss of " + ml_cash(c.divest) + " and tell no one. Le Guin: they seem to know where they are going, the ones who walk away from Omelas.")
        }
      }
    ],
    outcomes: {
      stayed: fun (a0, a1, a2, a3) {
        if (ml_roll(35)) {
          ml_market(0.5)
          ml_rep(0, -8)
          ml_rep(2, -4)
          ml_note("News", "A journalist exposes the factory and publishes the names of everyone who knew. Yours is on page one. The crash takes the boom, and your reputation with it.")
        } else {
          ml_stress(10)
          ml_note(ML_TITLE, "The boom continues. The children are still there. Bentham counted the happiness of the many. Le Guin made you look at the one.")
        }
      },
      exposed: fun (a0, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_market(1.4)
          ml_happy(15)
          ml_note("News", "Reforms pass. The factory is closed and the children go home. The market recovers, slower and a little more honestly.")
        } else {
          ml_stress(20)
          ml_note(ML_TITLE, "The factory closed. The children were moved to another one, three borders away. The market forgot within a month. You didn't.")
        }
      }
    }
  },

  -- 10. Kant's murderer at the door (Constant 1797, Kant 1797) ---------------------
  {
    id: "door",
    title: "The Murderer at the Door",
    can: fun () {
      return ml_random_contact() > 0
    },
    setup: fun () {
      let h = ml_random_contact()
      return { human: h, who: ml_name(h) }
    },
    text: fun (c) {
      return ml_text([
        c.who, " is hiding in your back office from a violent ex. There's a knock. A man with a bulge in his coat asks, very politely, whether ", c.who, " is here.",
        "\n\nUTL: lie; a lie that saves a life is obviously right. DNT: Kant notoriously said you may not lie even here, but you may refuse to answer. VE: courage and practical wisdom: talk him down."
      ])
    },
    options: [
      {
        label: "UTL: Lie to him",
        school: "utl",
        run: fun (c) {
          ml_later(irandom_range(3, 7), "door", "lied", c.human, 0, 0, 0)
        }
      },
      {
        label: "DNT: Refuse to answer",
        school: "dnt",
        run: fun (c) {
          ml_later(irandom_range(2, 5), "door", "refused", c.human, 0, 0, 0)
        }
      },
      {
        label: "VE: Talk him down",
        school: "ve",
        run: fun (c) {
          ml_later(irandom_range(2, 5), "door", "talked", c.human, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      lied: fun (h, a1, a2, a3) {
        if (ml_roll(70)) {
          ml_friend(h, 25)
          ml_happy(10)
          ml_note(ML_TITLE, "He believed you and left. " + ml_name(h) + " is safe and has moved out of the city. Most philosophers since Kant have agreed with you, and none of them were at the door.")
        } else {
          ml_hospital()
          ml_friend(h, 10)
          ml_note("Oh no!", "He came back that night, angry at being lied to. " + ml_name(h) + " got away through the back. You didn't. Kant's grim warning: if you lie, the consequences become yours.")
        }
      },
      refused: fun (h, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_friend(h, 15)
          ml_rep(2, 2)
          ml_note(ML_TITLE, "He stared at you for a long time, then left. Silence kept both your integrity and your friend. Kant would note you never had to choose.")
        } else {
          ml_friend(h, -20)
          ml_stress(30)
          ml_note("Oh no!", "He pushed past you and found " + ml_name(h) + ". They survived, barely. You told no lie. You also told no one to run. Duty kept your hands clean and your friend in hospital.")
        }
      },
      talked: fun (h, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_rep(0, 3)
          ml_friend(h, 20)
          ml_note("News", "Local trader talks armed man into surrendering. He broke down on your doorstep and turned himself in. Courage, the mean between running and fighting.")
        } else {
          ml_hospital()
          ml_friend(h, 15)
          ml_note("Oh no!", "He didn't want to talk. You're in hospital with a knife wound, but " + ml_name(h) + " escaped while he was busy with you. Courage protected them. It didn't protect you.")
        }
      }
    }
  },

  -- 11. Aquinas' doctrine of double effect; assisted dying ----------------------------
  {
    id: "doublefx",
    title: "The Double Effect",
    can: fun () {
      return ml_random_contact() > 0
    },
    setup: fun () {
      let h = ml_random_contact()
      return { human: h, who: ml_name(h), hospice: ml_amt(0.06) }
    },
    text: fun (c) {
      return ml_text([
        c.who, " is dying, and it is not peaceful. They ask you to bring them pills from a clinic abroad, illegal here, and to sit with them when they take them.",
        "\n\nUTL: ending unbearable suffering is the kindest outcome. DNT: deliberately helping to kill is wrong, even when asked; Aquinas allowed only effects you foresee but don't intend. VE: compassion without crossing the line: pay for the best palliative care there is."
      ])
    },
    options: [
      {
        label: "UTL: Bring the pills",
        school: "utl",
        run: fun (c) {
          ml_later(irandom_range(4, 10), "doublefx", "pills", c.human, 0, 0, 0)
        }
      },
      {
        label: "DNT: Refuse, gently",
        school: "dnt",
        run: fun (c) {
          ml_friend(c.human, -20)
          ml_stress(15)
          ml_later(irandom_range(10, 20), "doublefx", "refused", c.human, 0, 0, 0)
        }
      },
      {
        label: "VE: Pay for hospice care",
        school: "ve",
        run: fun (c) {
          ml_lose(c.hospice)
          ml_rep(5, 1)
          ml_later(irandom_range(10, 20), "doublefx", "hospice", c.human, 0, 0, 0)
        }
      }
    ],
    outcomes: {
      pills: fun (h, a1, a2, a3) {
        if (ml_roll(60)) {
          ml_happy(-10)
          ml_stress(-10)
          ml_note(ML_TITLE, "You held " + ml_name(h) + "'s hand until the end. It was quiet. They said thank you.")
        } else {
          ml_rep(0, -3)
          ml_jail(30)
          ml_note("Court", "Customs flagged the package. A month inside for importing controlled substances. " + ml_name(h) + " died a week later, in pain, waiting for you.")
        }
      },
      refused: fun (h, a1, a2, a3) {
        if (ml_roll(50)) {
          ml_stress(20)
          ml_note(ML_TITLE, ml_name(h) + " died last night. It wasn't easy. Kant says duty never promised you'd feel good about doing it.")
        } else {
          ml_friend(h, 25)
          ml_happy(5)
          ml_note(ML_TITLE, "A new pain treatment gives " + ml_name(h) + " three good weeks at the end. They say they're glad you said no. You'll never know if you were right or just lucky.")
        }
      },
      hospice: fun (h, a1, a2, a3) {
        ml_happy(10)
        ml_friend(h, 15)
        ml_note(ML_TITLE, "The hospice was everything the brochure promised. A middle path between doing and refusing, and " + ml_name(h) + ", mostly, approved.")
      }
    }
  },

  -- 12. Loyalty or truth: the interrogation room ---------------------------------------
  {
    id: "prisoners",
    title: "Loyalty or Truth",
    can: fun () {
      return ml_random_company() >= 0
    },
    setup: fun () {
      let co = ml_random_company()
      return { co: co, co_name: global.company_name[co], human: 0 }
    },
    text: fun (c) {
      return ml_text([
        "You and the CEO of ", c.co_name, ", an old ally, are in separate interview rooms. The regulator is sure you two coordinated trades last quarter. You did.",
        "\n\nUTL: negotiate a joint plea that keeps total harm lowest. DNT: you were asked a question and you owe the truth: testify. VE: loyalty is a virtue; stay silent and trust your friend to do the same."
      ])
    },
    options: [
      {
        label: "UTL: Negotiate a joint plea",
        school: "utl",
        run: fun (c) {
          ml_later(irandom_range(3, 6), "prisoners", "plea", c.co, c.co_name, 0, 0)
        }
      },
      {
        label: "DNT: Tell the truth",
        school: "dnt",
        run: fun (c) {
          ml_later(irandom_range(3, 6), "prisoners", "truth", c.co, c.co_name, 0, 0)
        }
      },
      {
        label: "VE: Stay loyal, stay silent",
        school: "ve",
        run: fun (c) {
          ml_later(irandom_range(3, 6), "prisoners", "silent", c.co, c.co_name, 0, 0)
        }
      }
    ],
    outcomes: {
      plea: fun (co, name, a2, a3) {
        if (ml_roll(70)) {
          ml_lose(ml_amt(0.08))
          ml_rep(0, -2)
          ml_note("Court", "The joint plea goes through: a heavy fine each, no prison. Nobody's happy, nobody's ruined. The minimum total harm, exactly as calculated.")
        } else {
          ml_lose(ml_amt(0.08))
          ml_jail(60)
          ml_note("Court", "The judge rejects the plea as too lenient and makes an example of you both. The fine, plus two months. The expected value was good. The judge wasn't.")
        }
      },
      truth: fun (co, name, a2, a3) {
        if (ml_roll(50)) {
          ml_rep(2, 3)
          ml_rep(3, -3)
          if (ml_company_ok(co, name)) {
            ml_hype(co, -0.5)
          }
          ml_note("Court", "You told the whole truth, including your own part. The regulator rewards candour: a fine for you, charges for " + name + "'s CEO. Your old ally will never speak to you again.")
        } else {
          ml_lose(ml_amt(0.1))
          ml_rep(2, 2)
          ml_jail(120)
          ml_note("Court", "Your honest testimony convicted you both. Four months each. You owed the truth, and you paid it in full.")
        }
      },
      silent: fun (co, name, a2, a3) {
        if (ml_roll(50)) {
          ml_lose(ml_amt(0.03))
          ml_rep(3, 3)
          ml_note("Court", "You both stayed silent. A small fine each, and a friendship that's now unbreakable. Loyalty paid.")
        } else {
          ml_lose(ml_amt(0.15))
          ml_rep(0, -5)
          ml_jail(365)
          ml_note("Court", "The CEO of " + name + " talked. You didn't. They walked out the front door; you got a year. Loyalty is a virtue. It needs a friend who has it too.")
        }
      }
    }
  }
]

-- Encounters with great figures -------------------------------------------------
-- Unlock when a school reaches ML_UNLOCK choices; each happens once per save.
-- Per school: one great reward, one choice that decides, one dire ordeal.
-- Single-button encounters use school "" so they don't count toward the ledger.

ML_ENCOUNTERS = [

  -- UTL: reward -------------------------------------------------------------------
  {
    id: "mill",
    school: "utl",
    title: "John Stuart Mill",
    can: fun () {
      return true
    },
    setup: fun () {
      return { human: 0, gift: ml_amt(0.2) }
    },
    text: fun (c) {
      return ml_text([
        "A thin man in a Victorian frock coat is waiting in your office. Nobody saw him come in. He introduces himself as John Stuart Mill and says he has been reading your ledger.",
        "\n\n'It is better to be a human being dissatisfied than a pig satisfied; better to be Socrates dissatisfied than a fool satisfied. You have been counting welfare well. Let me teach you to count it wisely.'",
        "\n\nHe talks until dawn."
      ])
    },
    options: [
      {
        label: "Listen until dawn",
        school: "",
        run: fun (c) {
          ml_happy(40)
          ml_stress(-40)
          ml_rep(4, 3)
          ml_rep(5, 2)
          ml_gain(c.gift)
          ml_note(ML_TITLE, "Mill leaves at sunrise. You understand the market, and yourself, a little better. Somehow your accounts are " + ml_cash(c.gift) + " richer. Higher pleasures, it turns out, compound.")
        }
      }
    ],
    outcomes: {}
  },

  -- UTL: choice ---------------------------------------------------------------------
  {
    id: "bentham",
    school: "utl",
    title: "Bentham's Panopticon",
    can: fun () {
      return true
    },
    setup: fun () {
      return { human: 0, cost: ml_amt(0.1) }
    },
    text: fun (c) {
      return ml_text([
