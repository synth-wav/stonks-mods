]

-- Engine ---------------------------------------------------------------------

ml_find = fun (id) {
  let i = 0
  while (i < array_length(ML_DILEMMAS)) {
    if (ML_DILEMMAS[i].id == id) {
      return ML_DILEMMAS[i]
    }
    i += 1
  }
  return undefined
}

ml_blocked = fun () {
  if (!instance_exists(o_control) or instance_exists(o_vn)) {
    return true
  }
  if (global.turma == 1 or global.hospital == 1 or global.startmode == 1 or global.totalbankrupt != 0) {
    return true
  }
  if (global.otpuskdays > 0) {
    return true
  }
  return !is_undefined(mod.cur)
}

ml_recent = fun (id) {
  let i = 0
  while (i < array_length(mod.recent)) {
    if (mod.recent[i] == id) {
      return true
    }
    i += 1
  }
  return false
}

-- Pick a dilemma whose requirements are met, avoiding the last few seen.
ml_pick_dilemma = fun () {
  let fresh = []
  let any = []
  let i = 0
  while (i < array_length(ML_DILEMMAS)) {
    let d = ML_DILEMMAS[i]
    if (d.can()) {
      array_push(any, d)
      if (!ml_recent(d.id)) {
        array_push(fresh, d)
      }
    }
    i += 1
  }
  if (array_length(fresh) > 0) {
    return fresh[irandom(array_length(fresh) - 1)]
  }
  if (array_length(any) > 0) {
    return any[irandom(array_length(any) - 1)]
  }
  return undefined
}

ml_start = fun (d) {
  let ctx = d.setup()
  mod.cur = { id: d.id, ctx: ctx }
  array_push(mod.recent, d.id)
  if (array_length(mod.recent) > 6) {
    array_delete(mod.recent, 0, 1)
  }
  mod.last_day = ml_ctl().gameday
  let buttons = []
  let k = 0
  while (k < array_length(d.options)) {
    array_push(buttons, [d.options[k].label, "morallylucky.pick" + string(k)])
    k += 1
  }
  create_question_many(d.title, d.text(ctx), buttons, ctx.human)
}

ml_pick = fun (k) {
  if (is_undefined(mod.cur)) {
    return
  }
  let d = ml_find(mod.cur.id)
  let ctx = mod.cur.ctx
  mod.cur = undefined
  if (is_undefined(d) or k >= array_length(d.options)) {
    return
  }
  let opt = d.options[k]
  mod.ledger[opt.school] = mod.ledger[opt.school] + 1
  mod.choices += 1
  opt.run(ctx)
  if (mod.choices > 0 and (mod.choices - floor(mod.choices / ML_PROFILE_EVERY) * ML_PROFILE_EVERY) == 0) {
    ml_profile()
  }
}

ml_outcome = fun (id, key, a0, a1, a2, a3) {
  let d = ml_find(id)
  if (is_undefined(d) or !variable_struct_exists(d.outcomes, key)) {
    return
  }
  let f = d.outcomes[key]
  f(a0, a1, a2, a3)
}

ml_profile = fun () {
  let best = ML_SCHOOLS[0]
  let lines = ""
  let i = 0
  while (i < array_length(ML_SCHOOLS)) {
    let s = ML_SCHOOLS[i]
    if (mod.ledger[s] > mod.ledger[best]) {
      best = s
    }
    lines += ML_SCHOOL_NAME[s] + ": " + string(mod.ledger[s]) + "\n"
    i += 1
  }
  ml_note("Know Thyself", lines + "\nYou lean toward " + ML_SCHOOL_NAME[best] + ". " + ML_SCHOOL_VOICE[best])
}

ml_ledger_reset = fun () {
  mod.ledger = { util: 0, kant: 0, virtue: 0, power: 0, care: 0 }
}

-- Mod ------------------------------------------------------------------------

mod = {
  name: "Morally Lucky",
  description: "Random moral dilemmas drawn from real philosophy, with big upsides, catastrophic downsides, and luck deciding which. Mature themes. F7 forces a dilemma; Shift+F7 shows your moral ledger.",

  cur: undefined,
  recent: [],
  last_day: -1000,
  choices: 0,
  ledger: { util: 0, kant: 0, virtue: 0, power: 0, care: 0 },

  start_game: fun () {
    -- Registered every session: dialog buttons and saved delayed
    -- consequences find these functions by name.
    mod_register_func("morallylucky.pick0", fun () { ml_pick(0) })
    mod_register_func("morallylucky.pick1", fun () { ml_pick(1) })
    mod_register_func("morallylucky.pick2", fun () { ml_pick(2) })
    mod_register_func("morallylucky.pick3", fun () { ml_pick(3) })
    mod_register_func("morallylucky.outcome", ml_outcome)
  },

  new_day: fun () {
    if (ml_blocked()) {
      return
    }
    let day = ml_ctl().gameday
    if (day < ML_FIRST_DAY or (day - mod.last_day) < ML_COOLDOWN) {
      return
    }
    if (ml_roll(ML_CHANCE)) {
      let d = ml_pick_dilemma()
      if (!is_undefined(d)) {
        ml_start(d)
      }
    }
  },

  input_capture: fun () {
    if (!keyboard_check_pressed(vk_f7) or !instance_exists(o_control) or window_blocks_world()) {
      return
    }
    keyboard_clear(vk_f7)
    if (keyboard_check(vk_shift)) {
      ml_profile()
      return
    }
    if (!is_undefined(mod.cur)) {
      ml_note(ML_TITLE, "A dilemma is already waiting for your answer.")
      return
    }
    let d = ml_pick_dilemma()
    if (!is_undefined(d)) {
      ml_start(d)
    }
  },

  save_data: fun () {
    return { recent: mod.recent, last_day: mod.last_day, choices: mod.choices, ledger: mod.ledger }
  },

  load_data: fun (state) {
    mod.cur = undefined
    mod.recent = []
    mod.last_day = -1000
    mod.choices = 0
    ml_ledger_reset()
    if (is_struct(state)) {
      if (variable_struct_exists(state, "recent") and is_array(state.recent)) {
        mod.recent = state.recent
      }
      if (variable_struct_exists(state, "last_day")) {
        mod.last_day = state.last_day
      }
      if (variable_struct_exists(state, "choices")) {
        mod.choices = state.choices
      }
      if (variable_struct_exists(state, "ledger") and is_struct(state.ledger)) {
        let i = 0
        while (i < array_length(ML_SCHOOLS)) {
          let s = ML_SCHOOLS[i]
          if (variable_struct_exists(state.ledger, s)) {
            mod.ledger[s] = state.ledger[s]
          }
          i += 1
        }
      }
    }
  }
}
return mod
