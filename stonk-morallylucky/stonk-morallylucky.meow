-- Engine ---------------------------------------------------------------------

ml_find_in = fun (list, id) {
  let i = 0
  while (i < array_length(list)) {
    if (list[i].id == id) {
      return list[i]
    }
    i += 1
  }
  return undefined
}

ml_find = fun (id) {
  let d = ml_find_in(ML_DILEMMAS, id)
  if (is_undefined(d)) {
    d = ml_find_in(ML_ENCOUNTERS, id)
  }
  return d
}

ml_contains = fun (list, id) {
  let i = 0
  while (i < array_length(list)) {
    if (list[i] == id) {
      return true
    }
    i += 1
  }
  return false
}

ml_blocked = fun () {
  if (!instance_exists(o_control) or instance_exists(o_vn)) {
    return true
  }
  if (global.turma == 1 or global.hospital == 1 or global.startmode == 1 or global.totalbankrupt != 0) {
    return true
  }
  if (global.otpuskdays > 0) {
    return true
  }
  return !is_undefined(mod.cur)
}

-- Pick a dilemma whose requirements are met, avoiding the last few seen.
ml_pick_dilemma = fun () {
  let fresh = []
  let any = []
  let i = 0
  while (i < array_length(ML_DILEMMAS)) {
    let d = ML_DILEMMAS[i]
    if (d.can()) {
      array_push(any, d)
      if (!ml_contains(mod.recent, d.id)) {
        array_push(fresh, d)
      }
    }
    i += 1
  }
  if (array_length(fresh) > 0) {
    return fresh[irandom(array_length(fresh) - 1)]
  }
  if (array_length(any) > 0) {
    return any[irandom(array_length(any) - 1)]
  }
  return undefined
}

-- Encounters the player has unlocked and not yet had.
ml_pick_encounter = fun () {
  let ok = []
  let i = 0
  while (i < array_length(ML_ENCOUNTERS)) {
    let e = ML_ENCOUNTERS[i]
    if (mod.ledger[e.school] >= ML_UNLOCK and !ml_contains(mod.met, e.id) and e.can()) {
      array_push(ok, e)
    }
    i += 1
  }
  if (array_length(ok) == 0) {
    return undefined
  }
  return ok[irandom(array_length(ok) - 1)]
}

-- An unlocked encounter some of the time, otherwise a dilemma.
ml_pick_any = fun () {
  let e = ml_pick_encounter()
  if (!is_undefined(e) and ml_roll(ML_ENCOUNTER_CHANCE)) {
    return e
  }
  return ml_pick_dilemma()
}

ml_start = fun (d) {
  let ctx = d.setup()
  mod.cur = { id: d.id, ctx: ctx }
  if (variable_struct_exists(d, "school")) {
    array_push(mod.met, d.id)
  } else {
    array_push(mod.recent, d.id)
    if (array_length(mod.recent) > 6) {
      array_delete(mod.recent, 0, 1)
    }
  }
  mod.last_day = ml_ctl().gameday
  let buttons = []
  let k = 0
  while (k < array_length(d.options)) {
    array_push(buttons, [d.options[k].label, "morallylucky.pick" + string(k)])
    k += 1
  }
  create_question_many(d.title, d.text(ctx), buttons, ctx.human)
}

ml_pick = fun (k) {
  if (is_undefined(mod.cur)) {
    return
  }
  let d = ml_find(mod.cur.id)
  let ctx = mod.cur.ctx
  mod.cur = undefined
  if (is_undefined(d) or k >= array_length(d.options)) {
    return
  }
  let opt = d.options[k]
  let s = opt.school
  if (s != "") {
    mod.ledger[s] = mod.ledger[s] + 1
    mod.choices += 1
  }
  opt.run(ctx)
  if (s != "" and mod.ledger[s] == ML_UNLOCK) {
    ml_note("The Ledger Stirs", ML_SCHOOL_UNLOCK[s] + "\n\nYou may now meet the great figures of " + ML_SCHOOL_NAME[s] + ".")
  } else if (s != "" and (mod.choices - floor(mod.choices / ML_PROFILE_EVERY) * ML_PROFILE_EVERY) == 0) {
    ml_profile()
  }
}

ml_outcome = fun (id, key, a0, a1, a2, a3) {
  let d = ml_find(id)
  if (is_undefined(d) or !variable_struct_exists(d.outcomes, key)) {
    return
  }
  let f = d.outcomes[key]
  f(a0, a1, a2, a3)
}

ml_met_count = fun (school) {
  let n = 0
  let i = 0
  while (i < array_length(ML_ENCOUNTERS)) {
    if (ML_ENCOUNTERS[i].school == school and ml_contains(mod.met, ML_ENCOUNTERS[i].id)) {
      n += 1
    }
    i += 1
  }
  return n
}

ml_profile = fun () {
  let best = ML_SCHOOLS[0]
  let lines = ""
  let i = 0
  while (i < array_length(ML_SCHOOLS)) {
    let s = ML_SCHOOLS[i]
    if (mod.ledger[s] > mod.ledger[best]) {
      best = s
    }
    let status = string(ml_met_count(s)) + "/3 figures met"
    if (mod.ledger[s] < ML_UNLOCK) {
      status = string(ML_UNLOCK - mod.ledger[s]) + " more to meet its figures"
    }
    lines += ML_SCHOOL_NAME[s] + ": " + string(mod.ledger[s]) + " (" + status + ")\n"
    i += 1
  }
  ml_note("Know Thyself", lines + "\nYou lean toward " + ML_SCHOOL_NAME[best] + ". " + ML_SCHOOL_VOICE[best])
}

ml_ledger_reset = fun () {
  mod.ledger = { ve: 0, utl: 0, dnt: 0 }
}

-- Old saves used five schools. Fold them into the three normative ones;
-- will-to-power and care choices don't map cleanly, so they're dropped.
ML_LEGACY = { virtue: "ve", util: "utl", kant: "dnt" }

-- Mod ------------------------------------------------------------------------

mod = {
  name: "Morally Lucky",
  description: "Normative-ethics dilemmas (virtue ethics, consequentialism, deontology) with luck deciding the fallout, plus encounters with the great figures of each school. Mature themes. F7 forces a dilemma; Ctrl+F7 an encounter; Shift+F7 shows your ledger.",

  cur: undefined,
  recent: [],
  met: [],
  last_day: -1000,
  choices: 0,
  ledger: { ve: 0, utl: 0, dnt: 0 },

  start_game: fun () {
    -- Registered every session: dialog buttons and saved delayed
    -- consequences find these functions by name.
    mod_register_func("morallylucky.pick0", fun () { ml_pick(0) })
    mod_register_func("morallylucky.pick1", fun () { ml_pick(1) })
    mod_register_func("morallylucky.pick2", fun () { ml_pick(2) })
    mod_register_func("morallylucky.pick3", fun () { ml_pick(3) })
    mod_register_func("morallylucky.outcome", ml_outcome)
  },

  new_day: fun () {
    if (ml_blocked()) {
      return
    }
    let day = ml_ctl().gameday
    if (day < ML_FIRST_DAY or (day - mod.last_day) < ML_COOLDOWN) {
      return
    }
    if (ml_roll(ML_CHANCE)) {
      let d = ml_pick_any()
      if (!is_undefined(d)) {
        ml_start(d)
      }
    }
  },

  input_capture: fun () {
    if (!keyboard_check_pressed(vk_f7) or !instance_exists(o_control) or window_blocks_world()) {
      return
    }
    keyboard_clear(vk_f7)
    if (keyboard_check(vk_shift)) {
      ml_profile()
      return
    }
    if (!is_undefined(mod.cur)) {
      ml_note(ML_TITLE, "A dilemma is already waiting for your answer.")
      return
    }
    let d = undefined
    if (keyboard_check(vk_control)) {
      d = ml_pick_encounter()
      if (is_undefined(d)) {
        ml_note(ML_TITLE, "No great figure wants to meet you yet. Reach " + string(ML_UNLOCK) + " choices in a school, then come back. Shift+F7 shows your ledger.")
        return
      }
    } else {
      d = ml_pick_any()
    }
    if (!is_undefined(d)) {
      ml_start(d)
    }
  },

  save_data: fun () {
    return { recent: mod.recent, met: mod.met, last_day: mod.last_day, choices: mod.choices, ledger: mod.ledger }
  },

  load_data: fun (state) {
    mod.cur = undefined
    mod.recent = []
    mod.met = []
    mod.last_day = -1000
    mod.choices = 0
    ml_ledger_reset()
    if (!is_struct(state)) {
      return
    }
    if (variable_struct_exists(state, "recent") and is_array(state.recent)) {
      mod.recent = state.recent
    }
    if (variable_struct_exists(state, "met") and is_array(state.met)) {
      mod.met = state.met
    }
    if (variable_struct_exists(state, "last_day")) {
      mod.last_day = state.last_day
    }
    if (variable_struct_exists(state, "ledger") and is_struct(state.ledger)) {
      let l = state.ledger
      let i = 0
      while (i < array_length(ML_SCHOOLS)) {
        let s = ML_SCHOOLS[i]
        if (variable_struct_exists(l, s)) {
          mod.ledger[s] = l[s]
        }
        i += 1
      }
      let old = variable_struct_get_names(ML_LEGACY)
      let j = 0
      while (j < array_length(old)) {
        if (variable_struct_exists(l, old[j])) {
          let to = ML_LEGACY[old[j]]
          mod.ledger[to] = mod.ledger[to] + l[old[j]]
        }
        j += 1
      }
    }
    mod.choices = mod.ledger.ve + mod.ledger.utl + mod.ledger.dnt
  }
}
return mod
