          ml_note("Oh no!", "They came back. You wake up in hospital with two cracked ribs and a get-well card with no name on it. Nasty, brutish, and thankfully short.")
        }
      },
      police: fun (a0, a1, a2, a3) {
        let r = irandom(99)
        if (r < 50) {
