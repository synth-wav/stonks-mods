-- Enhanced Keyboard Controls (stonk-kbnhance)
-- Keyboard navigation for the Exchange window (o_birza).
--
--   Tab               next tab (Stocks, Shorts, Portfolio, Commodities)
--   Up / Down         move the highlighted row (crosses pages)
--   Left / Right      previous / next page (built into the game)
--   + / -             buy / sell the highlighted row (hold to repeat, = and numpad work too)
--   W                 cycle the quantity multiplier (the game only does this on
--                     Commodities; the mod adds it to Stocks and Shorts)
--   Enter             confirm the deal
--   I                 open the highlighted company's details
--   B                 bulk buy prompt for the highlighted stock
--   Esc               close the exchange (built into the game)
--
-- In Charts (companies or commodities):
--   Up / Down         highlight the next / previous line (the legend row turns
--                     white, as on mouse hover)
--   S                 solo the highlighted line: hide the rest and show it on a
--                     chart zoomed to its own range. S again restores the rest.
--
-- Outside the exchange:
--   . / ,             speed time up / slow it down (pause, normal, fast, turbo)
--   Space             pause / resume (built into the game)
--
-- The game only reads clicks from the real mouse, so + / - / Enter / I / B / W
-- replicate the exact code paths of the matching buttons in
-- o_birza's Draw event (limits, timers, multiplier, hold acceleration).
--
-- Top-level helpers are assigned without `let` so the mod's callbacks can
-- see them (see modding_guide.txt).

KBX_TAB_ORDER = [0, 1, 2, 4]
KBX_KEY_PLUS = [187, 107]    -- "=/+" key, numpad +
KBX_KEY_MINUS = [189, 109]   -- "-" key, numpad -

kbx_birza = fun () {
  if (!instance_exists(o_birza)) {
    return undefined
  }
  return instance_find(o_birza, 0)
}

-- Same gate o_birza uses before it accepts clicks (bclick / window checks).
kbx_blocked = fun () {
  if (global.windowopen != 0) {
    return true
  }
  if (window_blocks_world()) {
    return true
  }
  if (instance_exists(o_human) or instance_exists(o_company) or instance_exists(o_shop) or instance_exists(o_calendar) or instance_exists(o_contacts) or instance_exists(o_kalkulator)) {
    return true
  }
  return false
}

-- Bind a game script/builtin to an instance so it runs as that instance.
-- Catspeak's `method` unwraps to catspeak_method, so pass the raw index.
kbx_bind = fun (inst, f) {
  return method(inst, method_get_index(f))
}

kbx_any_down = fun (keys) {
  let k = 0
  while (k < array_length(keys)) {
    if (keyboard_check(keys[k])) {
      return true
    }
    k += 1
  }
  return false
}

-- Slot indices shown as rows on the current tab/page, in display order.
kbx_rows = fun (b) {
  let rows = []
  let t = b.vkladka
  if (t == 4) {
    let c = 0
    while (c < 6) {
      array_push(rows, c)
      c += 1
    }
    return rows
  }
  if (t == 3) {
    return rows
  }
  let range = birza_page_range(b.page, b.max_on_pages)
  let i = range.start
  while (i < range.stop) {
    if (global.company_stockprice[i] > 0) {
      array_push(rows, i)
    }
    i += 1
  }
  return rows
}

kbx_can_trade = fun (b) {
  return b.holyday == 0 and b.height_draw >= b.height and global.totalbankrupt == 0
}

-- Mirrors the per-share timer cost the game charges for buys.
kbx_share_time = fun (b, i) {
  return b.speedlimit * (1 / max(100000, global.company_number_a[i])) * 310000
}

-- Mirrors the tab buttons at the top of o_birza's Draw event.
kbx_set_tab = fun (b, t) {
  if (t == 1 and !(b.myrepanow >= b.needrepa or global.short_av == 1)) {
    b.vkladka = 3
    return
  }
  b.vkladka = t
  if (t == 0 or t == 1) {
    let buy = b.comp_ac_buy
    let seff = b.comp_ac_seff
    let st = b.comp_ac_start
    let st2 = b.comp_ac2_start
    let i = 0
    while (i < 30) {
      buy[i] = 0
      seff[i] = 0
      st[i] = global.company_ac[i]
      st2[i] = global.company_short[i]
      i += 1
    }
    b.limit = money_round(global.money + ((global.fortune - global.money) * 0.75)) - global.short_dolg
    if (global.char[1] > 50 and global.char[4] > 30) {
      b.limit = max(b.limit, 5000000000000000)
    }
  }
}

-- "+" on a Stocks / Shorts row.
kbx_stock_plus = fun (b, i, first, fire, n) {
  let t = b.vkladka
  let buy = b.comp_ac_buy
  let st = b.comp_ac_start
  let st2 = b.comp_ac2_start
  if (b.timeout > 0 and buy[i] >= 0) {
    return
  }
  if (t == 1 and global.bankrupt_dali == i) {
    if (first) {
      create_notification(txt(546), txt(4510))
    }
    return
  }
  let cena = global.company_stockprice[i] / global.company_number_a[i]
  let allowed = b.get_stock_allowed_limit(i)
  let limitno = 0
  let reason = ""
  if (t == 0) {
    if ((st[i] + buy[i]) >= (allowed - 5)) {
      limitno = 1
    }
  } else if (buy[i] >= 0) {
    if ((buy[i] + st[i] + st2[i]) >= global.company_number_a[i]) {
      limitno = 1
      reason = txt(4788)
    } else if ((buy[i] + st[i]) >= allowed) {
      limitno = 1
      reason = txt(4786)
    } else if ((b.limit - cena) < -b.balance) {
      limitno = 1
      if (global.short_dolg > 0) {
        reason = txt(4787)
      } else {
        reason = txt("short_no_credit_open")
      }
    }
  }
  if (limitno == 1) {
    if (first) {
      if (reason == "") {
        reason = txt(1573)
      }
      create_notification(txt(546), reason)
    }
    return
  }
  if (!fire) {
    return
  }
  let ctl = instance_find(o_control, 0)
  let figa_b = kbx_bind(b, figa)
  let k = 0
  while (k < n) {
    if (t == 0 and (st[i] + buy[i]) >= allowed) {
      limitno = 1
    }
    figa_b()
    if (limitno == 0) {
      if (t == 0) {
        if ((global.money - cena) >= -b.balance and (buy[i] + st[i]) < allowed) {
          ctl.timer += kbx_share_time(b, i)
          buy[i] = buy[i] + 1
        }
      }
      if (t == 1) {
        if (buy[i] < 0) {
          buy[i] = buy[i] + 1
        } else if ((b.limit - cena - global.short_dolg) >= -b.balance and (buy[i] + st[i]) < allowed and (buy[i] + st[i] + st2[i]) < global.company_number_a[i]) {
          ctl.timer += kbx_share_time(b, i)
          buy[i] = buy[i] + 1
        }
      }
    }
    k += 1
  }
}

-- "-" on a Stocks / Shorts row.
kbx_stock_minus = fun (b, i, fire, n) {
  let t = b.vkladka
  let buy = b.comp_ac_buy
  let st = b.comp_ac_start
  let st2 = b.comp_ac2_start
  if (b.timeout > 0 and buy[i] <= 0) {
    return
  }
  let figa_b = kbx_bind(b, figa)
  figa_b()
  if (!fire) {
    return
  }
  let ctl = instance_find(o_control, 0)
  let k = 0
  while (k < n) {
    if (t == 0) {
      if ((buy[i] + st[i]) > 0) {
        if (buy[i] < 0) {
          ctl.timer += b.speedlimit
        }
        buy[i] = buy[i] - 1
      }
    }
    if (t == 1) {
      if ((st2[i] + buy[i]) > 0) {
        figa_b()
        let unit = round(global.company_stockprice[i] / max(1, global.company_number_a[i]))
        let projected = (global.money + (b.money_trata * global.short_procent)) - b.money_pribil - unit
        if (projected >= -1000000) {
          ctl.timer += b.speedlimit
          buy[i] = buy[i] - 1
        }
      }
    }
    k += 1
  }
}

-- "+" / "-" on a Commodities row.
kbx_comm_step = fun (b, i, dir, fire, n) {
  let buy = b.comm_ac_buy
  let st = b.comm_ac_start
  if (dir > 0 and b.timeout > 0 and buy[i] >= 0) {
    return
  }
  if (dir < 0 and b.timeout > 0 and buy[i] <= 0) {
    return
  }
  let figa2_b = kbx_bind(b, figa2)
  if (dir < 0) {
    figa2_b()
  }
  if (!fire) {
    return
  }
  let ctl = instance_find(o_control, 0)
  let cena = global.commodity_price[i]
  let k = 0
  while (k < n) {
    if (dir > 0) {
      figa2_b()
      if ((global.money - cena) >= -b.balance) {
        ctl.timer += kbx_share_time(b, i)
        buy[i] = buy[i] + 1
      }
    } else if ((buy[i] + st[i]) > 0) {
      ctl.timer += kbx_share_time(b, i)
      buy[i] = buy[i] - 1
    }
    k += 1
  }
}

-- Mirrors the confirm button (event_user 0 on o_birza).
kbx_confirm = fun (b) {
  if (b.holyday != 0) {
    return
  }
  let t = b.vkladka
  let ok = false
  if ((t == 0 or t == 4) and b.balance != 0) {
    ok = true
  }
  if (t == 1) {
    if (b.balance != 0) {
      ok = true
    }
    let buy = b.comp_ac_buy
    let i = 0
    while (i < 30) {
      if (buy[i] != 0) {
        ok = true
      }
      i += 1
    }
  }
  if (!ok) {
    return
  }
  -- A Catspeak `with` makes builtins run as `b`. Binding event_user with
  -- method() did not apply the deal in-game, so don't use kbx_bind here.
  with (b) {
    event_user(0)
  }
  -- A successful confirm zeroes every pending order.
  let pending = b.comp_ac_buy
  let n = 30
  if (t == 4) {
    pending = b.comm_ac_buy
    n = 6
  }
  let i = 0
  while (i < n) {
    if (pending[i] != 0) {
      create_notification("Enhanced Keyboard Controls", "Enter could not confirm the deal. Click the deal button to confirm instead.")
      return
    }
    i += 1
  }
}

-- Mirrors the multiplier button: 1 > 2 > 5 > 10 > 25 > 50 > 100 > 500 > 1.
KBX_MULTS = [1, 2, 5, 10, 25, 50, 100, 500]
kbx_next_mult = fun () {
  let k = 0
  while (k < array_length(KBX_MULTS)) {
    if (KBX_MULTS[k] == global.mnozhitel) {
      if (k == array_length(KBX_MULTS) - 1) {
        return KBX_MULTS[0]
      }
      return KBX_MULTS[k + 1]
    }
    k += 1
  }
  return 2
}

-- Time speed: 1 pause, 2 normal, 3 fast (the top-bar buttons), 4 turbo.
-- Speed 4 already exists in o_control's timer code but has no button.
KBX_MAX_SPEED = 4
kbx_time_keys = fun () {
  let faster = keyboard_check_pressed(190)   -- "."
  let slower = keyboard_check_pressed(188)   -- ","
  if (!faster and !slower) {
    return
  }
  if (!instance_exists(o_control) or instance_exists(o_birza) or instance_exists(o_vn) or instance_exists(o_kalkulator)) {
    return
  }
  if (global.windowopen != 0 or window_blocks_world() or global.totalbankrupt != 0) {
    return
  }
  let ctl = instance_find(o_control, 0)
  let s = ctl.time_speed
  if (faster and s < KBX_MAX_SPEED) {
    s += 1
  }
  if (slower and s > 1) {
    s -= 1
  }
  ctl.time_speed = s
  if (s > 1) {
    ctl.time_speed_now = s
  }
}

-- ---------------------------------------------------------------------------
-- Charts view (global.vybrano == 2, drawn in o_control's Draw event)
--
-- o_control.chart_type: 0 companies, 1 commodities, 2 heatmap (not handled).
-- global.activechart is the highlighted series. The game sets it from mouse
-- hover in the legend, AFTER chart_draw has already used it, and the chart
-- only re-renders its cached surface when chart_update() marks it dirty. So
-- the mod sets it in the `draw` hook (top of Draw, before chart_draw) and
-- marks the chart dirty only when the selection changes.
-- global.compchart_active[i] is each series' visible flag; o_control keeps a
-- copy per chart type in chart_comp / chart_field (synced in End Step).

KBX_CHART_HIDDEN_Y = 100000

-- o_control while the company or commodity chart is the current view.
kbx_chart_view = fun () {
  if (room_get() != RoomMain or global.vybrano != 2 or !instance_exists(o_control)) {
    return undefined
  }
  let ctl = instance_find(o_control, 0)
  if (ctl.chart_type != 0 and ctl.chart_type != 1) {
    return undefined
  }
  return ctl
}

-- Same, but undefined while the chart isn't actually on screen (an event,
-- the Exchange or a window on top).
kbx_chart_ctl = fun () {
  let ctl = kbx_chart_view()
  if (is_undefined(ctl)) {
    return undefined
  }
  if (global.event != 0 or instance_exists(o_birza) or instance_exists(o_company)) {
    return undefined
  }
  if (global.windowopen != 0 or window_blocks_world()) {
    return undefined
  }
  return ctl
}

kbx_chart_map = fun (ctl, t) {
  if (t == 1) {
    return ctl.chartCommodity
  }
  return ctl.chartCompany
}

-- Series indices in legend order.
kbx_chart_rows = fun (t) {
  let rows = []
  if (t == 1) {
    let c = 0
    while (c < 6) {
      array_push(rows, c)
      c += 1
    }
    return rows
  }
  let i = 0
  while (i < global.numberofcompany) {
    if (global.company_price[i] > 0) {
      array_push(rows, i)
    }
    i += 1
  }
  return rows
}

kbx_index_of = fun (arr, v) {
  let k = 0
  while (k < array_length(arr)) {
    if (arr[k] == v) {
      return k
    }
    k += 1
  }
  return -1
}

-- Hide every series except `sel`. The game's own chart is moved off-screen
-- (its "y" in the chart map) and kbx_solo_draw draws a zoomed one instead:
-- the game's axis always starts at 0, which flattens a single stock's line.
kbx_solo_apply = fun (ctl, t, sel) {
  let act = global.compchart_active
  if (!mod.solo) {
    mod.solo = true
    mod.solo_type = t
    mod.solo_saved = []
    let k = 0
    while (k < 30) {
      array_push(mod.solo_saved, act[k])
      k += 1
    }
    let m = kbx_chart_map(ctl, t)
    mod.solo_y = ds_map_find_value(m, "y")
    ds_map_replace(m, "y", KBX_CHART_HIDDEN_Y)
  }
  let i = 0
  while (i < 30) {
    act[i] = 0
    i += 1
  }
  act[sel] = 1
  chart_update(kbx_chart_map(ctl, t))
}

-- Restore the visible flags saved by kbx_solo_apply, and the chart position.
kbx_solo_off = fun () {
  if (!mod.solo) {
    return
  }
  mod.solo = false
  if (!instance_exists(o_control)) {
    return
  }
  let ctl = instance_find(o_control, 0)
  let t = mod.solo_type
  let m = kbx_chart_map(ctl, t)
  ds_map_replace(m, "y", mod.solo_y)
  let store = ctl.chart_comp
  if (t == 1) {
    store = ctl.chart_field
  }
  let same_view = global.vybrano == 2 and ctl.chart_type == t
  let act = global.compchart_active
  let i = 0
  while (i < 30) {
    store[i] = mod.solo_saved[i]
    if (same_view) {
      act[i] = mod.solo_saved[i]
    }
    i += 1
  }
  chart_update(m)
}

kbx_chart_reset = fun () {
  kbx_solo_off()
  if (mod.chart_kb and instance_exists(o_control)) {
    let ctl = instance_find(o_control, 0)
    chart_update(ctl.chartCompany)
    chart_update(ctl.chartCommodity)
  }
  mod.chart_kb = false
  mod.chart_drawn = -1
}

-- Up / Down move the highlight, S solos it. Runs in input_capture.
kbx_chart_keys = fun () {
  let up = keyboard_check_pressed(vk_up)
  let down = keyboard_check_pressed(vk_down)
  let solo_key = keyboard_check_pressed(ord("S"))
  if (!up and !down and !solo_key) {
    return
  }
  let ctl = kbx_chart_ctl()
  if (is_undefined(ctl) or kbx_blocked() or keyboard_check(vk_alt)) {
    return
  }
  let t = ctl.chart_type
  let rows = kbx_chart_rows(t)
  let n = array_length(rows)
  if (n == 0) {
    return
  }
  let pos = -1
  if (mod.chart_kb) {
    pos = kbx_index_of(rows, mod.chart_sel)
  } else if (global.activechart >= 0) {
    -- Start from the row under the mouse, if any.
    pos = kbx_index_of(rows, global.activechart)
  }
  if (up or down) {
    if (pos < 0) {
      pos = 0
      if (up) {
        pos = n - 1
      }
    } else if (down) {
      pos += 1
      if (pos >= n) {
        pos = 0
      }
    } else {
      pos -= 1
      if (pos < 0) {
        pos = n - 1
      }
    }
    keyboard_clear(vk_up)
    keyboard_clear(vk_down)
  } else if (pos < 0) {
    pos = 0
  }
  mod.chart_kb = true
  mod.chart_type_seen = t
  mod.chart_sel = rows[pos]

  if (solo_key) {
    keyboard_clear(ord("S"))
    if (mod.solo) {
      kbx_solo_off()
      return
    }
    kbx_solo_apply(ctl, t, mod.chart_sel)
    return
  }
  if (mod.solo) {
    kbx_solo_apply(ctl, t, mod.chart_sel)
  }
}

-- Rounds a raw tick step up to 1, 2 or 5 x 10^k.
kbx_nice_step = fun (raw) {
  if (raw <= 0) {
    return 1
  }
  let mag = power(10, floor(log10(raw)))
  let f = raw / mag
  if (f <= 1) {
    return mag
  }
  if (f <= 2) {
    return 2 * mag
  }
  if (f <= 5) {
    return 5 * mag
  }
  return 10 * mag
}

-- The zoomed chart for a soloed series, in the space the game's chart uses
-- (same position and size maths as chart_draw).
kbx_solo_draw = fun (ctl) {
  let t = mod.solo_type
  let m = kbx_chart_map(ctl, t)
  let series = ds_list_find_value(ds_map_find_value(m, "series"), mod.chart_sel)
  if (is_undefined(series)) {
    return
  }
  if (!ds_exists(series, ds_type_map)) {
    return
  }
  let data = ds_map_find_value(series, "data")
  let n = ds_list_size(data)
  if (n < 2) {
    return
  }
  let lo = ds_list_find_value(data, 0)
  let hi = lo
  let j = 1
  while (j < n) {
    let v = ds_list_find_value(data, j)
    lo = min(lo, v)
    hi = max(hi, v)
    j += 1
  }

  -- Axis: 4-6 round-number gridlines hugging the data.
  let step = kbx_nice_step(max(hi - lo, max(1, abs(hi) * 0.01)) / 5)
  let a_lo = floor(lo / step) * step
  let a_hi = ceil(hi / step) * step
  if (a_hi <= a_lo) {
    a_hi = a_lo + step
  }

  let old_col = draw_get_colour()
  let old_alpha = draw_get_alpha()
  let old_font = draw_get_font()
  let old_ha = draw_get_halign()
  let old_va = draw_get_valign()
  draw_set_font(global.font)

  let longnam = 0
  let c = 0
  while (c < 30) {
    if (global.company_price[c] > 0 and global.company_liq[c] == 0) {
      longnam = max(longnam, string_width(string(global.company_name[c]) + " " + string_thousands(price_stock(c))))
    }
    c += 1
  }
  let he = string_height("X")
  let x1 = 17 + longnam - global.x_new_offset
  let y1 = 13 - global.y_new_offset
  let w = 372 + (global.x_new_offset * 2) - 8
  let h = 235 + (global.y_new_offset * 2)
  let pad_l = string_width(string_thousands(a_hi + 5)) + 5
  let px1 = x1 + pad_l
  let px2 = x1 + w - string_width("XXX")
  let py1 = y1 + (he / 2) + 4
  let py2 = y1 + h - (he / 2)
  let fg = ds_map_find_value(m, "foreground_colour")

  draw_set_halign(fa_left)
  draw_set_valign(fa_top)
  let g = a_hi
  while (g >= a_lo - (step / 2)) {
    let gy = py2 - ((g - a_lo) / (a_hi - a_lo)) * (py2 - py1)
    draw_set_alpha(0.6)
    draw_line_colour(px1, gy, px2, gy, fg, fg)
    draw_set_alpha(1)
    draw_text_colour(x1 + 4, gy - (he / 2), string_thousands(g), fg, fg, fg, fg, 1)
    g -= step
  }

  let col = ds_map_find_value(series, "colour")
  let dx = (px2 - px1) / (n - 1)
  j = 0
  while (j < n - 1) {
    let v0 = ds_list_find_value(data, j)
    let v1 = ds_list_find_value(data, j + 1)
    let y0 = py2 - ((v0 - a_lo) / (a_hi - a_lo)) * (py2 - py1)
    let y_1 = py2 - ((v1 - a_lo) / (a_hi - a_lo)) * (py2 - py1)
    draw_line_width_colour(px1 + (j * dx), y0, px1 + ((j + 1) * dx), y_1, 2, col, col)
    j += 1
  }

  -- Change over the whole chart, top right.
  let first = ds_list_find_value(data, 0)
  let last = ds_list_find_value(data, n - 1)
  let label = "Solo"
  if (first != 0) {
    let pct = round(((last - first) / abs(first)) * 1000) / 10
    let sign = ""
    if (pct > 0) {
      sign = "+"
    }
    label = "Solo  " + sign + string(pct) + "%"
  }
  draw_set_halign(fa_right)
  draw_text_colour(px2, y1 + 2, label, col, col, col, col, 1)

  draw_set_colour(old_col)
  draw_set_alpha(old_alpha)
  draw_set_font(old_font)
  draw_set_halign(old_ha)
  draw_set_valign(old_va)
}

-- Redraws the selected legend row in white, the way the game marks the row
-- under the mouse (o_control Draw, legend loop: same positions and text).
kbx_chart_mark = fun (ctl) {
  let t = ctl.chart_type
  let rows = kbx_chart_rows(t)
  let pos = kbx_index_of(rows, mod.chart_sel)
  if (pos < 0) {
    return
  }
  let i = mod.chart_sel
  let comps = 8
  if (t == 0) {
    comps = array_length(rows)
  }
  let yyhh = 233 + (global.y_new_offset * 2)
  let ystartt = 13 - global.y_new_offset
  let xx_poss = 5 - global.x_new_offset
  let ty = ystartt + ((yyhh / comps) * pos) + global.yoffset
  let old_col = draw_get_colour()
  let old_font = draw_get_font()
  let old_ha = draw_get_halign()
  let old_va = draw_get_valign()
  draw_set_font(global.font)
  draw_set_halign(fa_left)
  draw_set_valign(fa_top)
  draw_set_colour(c_white)
  if (t == 0) {
    draw_text_scribble(7 + xx_poss, ty, global.company_name[i] + " " + string_thousands(round(global.company_stockprice[i] / global.company_number_a[i])))
  } else {
    draw_text(7 + xx_poss, ty, global.commodity_name[i] + " " + string_thousands(global.commodity_price[i]))
  }
  draw_set_colour(old_col)
  draw_set_font(old_font)
  draw_set_halign(old_ha)
  draw_set_valign(old_va)
}

mod = {
  name: "Enhanced Keyboard Controls",
  description: "Keyboard controls for the Exchange: Tab switches tabs, Up/Down select a row, "
    + "+/- buy/sell (hold to repeat), W multiplier, Enter confirms, I opens company details, B bulk-buys. "
    + "Outside it: . and , speed time up and down. "
    + "Charts: Up/Down highlight a company, S solos it on a zoomed chart.",

  sel: 0,
  hold: 0,
  last_inst: undefined,
  last_tab: -1,
  chart_kb: false,
  chart_sel: -1,
  chart_drawn: -1,
  chart_mx: 0,
  chart_my: 0,
  chart_type_seen: -1,
  solo: false,
  solo_type: 0,
  solo_saved: [],
  solo_y: 13,

  input_capture: fun () {
    kbx_time_keys()
    kbx_chart_keys()
    let b = kbx_birza()
    if (is_undefined(b)) {
      mod.last_inst = undefined
      mod.hold = 0
      return
    }
    if (mod.last_inst != b) {
      mod.last_inst = b
      mod.sel = 0
      mod.hold = 0
      mod.last_tab = b.vkladka
    }
    if (mod.last_tab != b.vkladka) {
      mod.last_tab = b.vkladka
      mod.sel = 0
    }
    if (kbx_blocked()) {
      mod.hold = 0
      return
    }

    -- Tab switching (forward only: Shift+Tab is Steam's overlay shortcut)
    if (keyboard_check_pressed(vk_tab)) {
      let pos = 1
      if (b.vkladka != 3) {
        pos = 0
        while (KBX_TAB_ORDER[pos] != b.vkladka) {
          pos += 1
        }
      }
      pos += 1
      if (pos >= array_length(KBX_TAB_ORDER)) {
        pos = 0
      }
      kbx_set_tab(b, KBX_TAB_ORDER[pos])
      mod.last_tab = b.vkladka
      mod.sel = 0
      keyboard_clear(vk_tab)
      return
    }

    -- Multiplier on Stocks / Shorts. On Commodities the game already reads W
    -- itself, so leave it alone there to avoid cycling twice.
    if (keyboard_check_pressed(ord("W")) and (b.vkladka == 0 or b.vkladka == 1) and b.holyday == 0) {
      global.mnozhitel = kbx_next_mult()
      keyboard_clear(ord("W"))
      return
    }

    let rows = kbx_rows(b)
    let count = array_length(rows)
    if (count == 0) {
      mod.hold = 0
      return
    }
    mod.sel = clamp(mod.sel, 0, count - 1)

    -- Row selection, rolling over to the neighbouring page
    if (keyboard_check_pressed(vk_up)) {
      if (mod.sel > 0) {
        mod.sel -= 1
      } else if (b.vkladka != 4 and b.page > 1) {
        b.page -= 1
        mod.sel = 99
      }
      keyboard_clear(vk_up)
      return
    }
    if (keyboard_check_pressed(vk_down)) {
      if (mod.sel < count - 1) {
        mod.sel += 1
      } else if (b.vkladka != 4 and b.page < b.pages) {
        b.page += 1
        mod.sel = 0
      }
      keyboard_clear(vk_down)
      return
    }

    let i = rows[mod.sel]
    let t = b.vkladka

    if (keyboard_check_pressed(vk_enter)) {
      kbx_confirm(b)
      keyboard_clear(vk_enter)
      return
    }

    if (keyboard_check_pressed(ord("I")) and t <= 2) {
      let c = instance_create(3, 3, o_company)
      if (instance_exists(c)) {
        c.human = i
        c.selected_company = i
        b.vsdvsd = c
      }
      keyboard_clear(ord("I"))
      return
    }

    if (keyboard_check_pressed(ord("B")) and t == 0) {
      if (kbx_can_trade(b) and global.money > (global.nikkei * 1000)) {
        b.stock_buy_number_prompt(i)
      }
      keyboard_clear(ord("B"))
      return
    }

    -- Buy / sell with the game's hold acceleration
    let plus = kbx_any_down(KBX_KEY_PLUS)
    let minus = kbx_any_down(KBX_KEY_MINUS)
    if ((!plus and !minus) or (plus and minus) or t == 2 or t == 3 or !kbx_can_trade(b)) {
      mod.hold = 0
      return
    }
    mod.hold += 1
    let h = mod.hold
    let first = h == 1
    let fire = first or (h > 16 and (h - floor(h / 3) * 3) == 0)
    let n = floor(global.mnozhitel * max(h * 0.03, 1))
    if (t == 4) {
      if (plus) {
        kbx_comm_step(b, i, 1, fire, n)
      } else {
        kbx_comm_step(b, i, -1, fire, n)
      }
    } else if (plus) {
      kbx_stock_plus(b, i, first, fire, n)
    } else {
      kbx_stock_minus(b, i, fire, n)
    }
  },

  -- Top of o_control's Draw, before chart_draw reads global.activechart.
  draw: fun () {
    if (!mod.chart_kb and !mod.solo) {
      return
    }
    let view = kbx_chart_view()
    if (is_undefined(view)) {
      kbx_chart_reset()
      return
    }
    if (view.chart_type != mod.chart_type_seen) {
      kbx_chart_reset()
      return
    }
    global.activechart = mod.chart_sel
    if (mod.chart_drawn != mod.chart_sel) {
      mod.chart_drawn = mod.chart_sel
      chart_update(kbx_chart_map(view, view.chart_type))
    }
  },

  draw_end: fun () {
    if (mod.chart_kb) {
      let cc = kbx_chart_ctl()
      if (!is_undefined(cc)) {
        -- Hovering a legend row with a moving mouse moves the keyboard
        -- selection too. A mouse left resting on the legend doesn't.
        let mx = mousex()
        let my = mousey()
        let moved = mx != mod.chart_mx or my != mod.chart_my
        mod.chart_mx = mx
        mod.chart_my = my
        if (moved and !mod.solo and global.activechart >= 0 and global.activechart != mod.chart_sel) {
          mod.chart_sel = global.activechart
        }
        if (mod.solo) {
          kbx_solo_draw(cc)
        }
        kbx_chart_mark(cc)
      }
    }

    -- Turbo (speed 4) has no top-bar button: light the "fast" arrows and add a third.
    let ctl = instance_find(o_control, 0)
    if (room_get() == RoomMain and global.hide_chars != 1 and ctl.time_speed == 4) {
      let oy = global.y_new_offset
      let old_c = draw_get_colour()
      draw_set_colour(global.color1)
      draw_triangle(104, 3 - oy, 104, 9 - oy, 110, 6 - oy, false)
      draw_triangle(109, 3 - oy, 109, 9 - oy, 115, 6 - oy, false)
      draw_triangle(114, 3 - oy, 114, 9 - oy, 120, 6 - oy, false)
      draw_set_colour(old_c)
    }

    let b = kbx_birza()
    if (is_undefined(b) or kbx_blocked()) {
      return
    }
    if (b.height_draw < b.height or b.width_draw < b.width) {
      return
    }
    let count = array_length(kbx_rows(b))
    if (count == 0) {
      return
    }
    -- Row band drawn with a MULTIPLY blend (result = band colour x screen).
    -- The light background takes on the band colour, but dark text stays
    -- dark, so text contrast survives the game's CRT ghosting. A normal
    -- translucent fill (v1/v2) lightened the text and washed it out.
    -- A thin solid accent bar sits at the far left, clear of any text.
    -- The band starts at x 16 so it covers the whole sector icon (drawn
    -- centred on x 25, 16px wide) without crossing the window's left border.
    -- Its colour is the palette's accent blended halfway toward white: a light
    -- tint keeps text readable on darker palettes.
    let r = clamp(mod.sel, 0, count - 1)
    let x1 = max(b.x - b.width_draw + 1, 16)
    let x2 = b.x + b.width_draw - 6
    let y1 = 48 + (r * b.otstup_bir) + 1
    let y2 = y1 + b.otstup_bir - 1
    let old_col = draw_get_colour()
    let old_alpha = draw_get_alpha()
    draw_set_alpha(1)
    draw_set_colour(merge_colour(16777215, global.color3, 0.5))
    gpu_set_blendmode_ext(bm_dest_colour, bm_zero)
    draw_rectangle(x1, y1, x2, y2, false)
    gpu_set_blendmode(bm_normal)
    draw_set_colour(global.color4)
    draw_rectangle(x1, y1, x1 + 1, y2, false)
    draw_set_colour(old_col)
    draw_set_alpha(old_alpha)
  }
}
return mod
