-- Any Raise (stonk-anyraise)
-- Raise any amount in the secret poker games, not just the two preset sizes.
--
-- While it's your turn, a row of controls sits above the Pot readout:
--
--   [-] [6. Raise 120] [+] [Pot]
--
--   - / +             lower / raise the amount (hold to repeat, = and numpad work too)
--   Mouse wheel       same as - / +
--   Shift             steps of 50 instead of 5
--   P                 jump to a pot-sized raise
--   6                 make the raise (also the middle button)
--
-- The game's own buttons 1-5 are untouched. Going all the way up reaches your
-- whole stack; that is sent as an All-in so side pots work as usual.
--
-- The raise goes through the game's own f_raise_to / f_bet (the scripts behind
-- buttons 2 and 3), so the pot, round bets, minimum re-raise and the
-- opponents' replies follow the game's rules.
--
-- Top-level helpers are assigned without `let` so the mod's callbacks can
-- see them (see modding_guide.txt).

ARZ_STEP = 5
ARZ_STEP_BIG = 50
ARZ_KEY_PLUS = [187, 107]    -- "=/+" key, numpad +
ARZ_KEY_MINUS = [189, 109]   -- "-" key, numpad -
ARZ_KEY_GO = [54, 102]       -- "6", numpad 6
ARZ_KEY_POT = 80             -- "P"
ARZ_KEY_SHIFT = 16

arz_poker = fun () {
  if (room_get() != rm_poker_game or !instance_exists(obj_poker_control)) {
    return undefined
  }
  return instance_find(obj_poker_control, 0)
}

arz_any_down = fun (keys) {
  let k = 0
  while (k < array_length(keys)) {
    if (keyboard_check(keys[k])) {
      return true
    }
    k += 1
  }
  return false
}

arz_any_pressed = fun (keys) {
  let k = 0
  while (k < array_length(keys)) {
    if (keyboard_check_pressed(keys[k])) {
      return true
    }
    k += 1
  }
  return false
}

-- The amounts in play for the player (seat 0). All values are "raise to"
-- totals for this betting round, the same numbers the game's buttons show.
-- Returns undefined when there is nothing between the presets and all-in.
arz_range = fun (pc) {
  if (!global.playable) {
    return undefined
  }
  let me = pc.player_stat[0]
  if (!instance_exists(me) or me.money <= 0) {
    return undefined
  }
  if (ds_list_find_index(global.active_players, 0) < 0) {
    return undefined
  }
  let already = ds_list_find_value(global.player_round_bets, 0)
  let cap = already + me.money
  let lo = 0
  if (global.check) {
    -- Nobody has bet this round: the game offers Bet 5 / Bet 10.
    lo = already + ARZ_STEP
  } else {
    lo = f_raise_target(global.latest_bet, global.last_raise, 1)
  }
  if (lo >= cap) {
    return undefined
  }
  let call_cost = max(0, global.latest_bet - already)
  -- One step past the game's bigger preset (button 3).
  let start = already + 15
  if (!global.check) {
    start = f_raise_target(global.latest_bet, global.last_raise, 3)
  }
  return {
    already: already,
    cap: cap,
    lo: lo,
    -- Pot-sized raise: call, then raise by the pot after the call.
    pot: global.latest_bet + global.pot + call_cost,
    start: start,
  }
}

arz_snap = fun (v, r) {
  return clamp(v, r.lo, r.cap)
}

arz_label = fun (r) {
  if (mod.amount >= r.cap) {
    return txt("poker_btn_all_in")
  }
  if (global.check) {
    return "Bet " + string(mod.amount - r.already)
  }
  return txt("poker_btn_raise") + " " + string(mod.amount)
}

-- Mirrors f_do_raise2x / f_do_raise3x with a chosen target.
arz_commit = fun (r) {
  if (!global.playable) {
    return
  }
  let target = arz_snap(mod.amount, r)
  if (target >= r.cap) {
    f_do_allin()
    return
  }
  if (global.check) {
    f_bet(target - r.already, 0)
  } else {
    f_raise_to(target, 0)
  }
  f_player_button_next()
}

arz_nudge = fun (r, dir) {
  let step = ARZ_STEP
  if (keyboard_check(ARZ_KEY_SHIFT)) {
    step = ARZ_STEP_BIG
  }
  let v = mod.amount + (dir * step)
  -- Land on round numbers after leaving the minimum.
  if (dir > 0 and mod.amount == r.lo) {
    v = (floor(r.lo / step) + 1) * step
  }
  mod.amount = arz_snap(v, r)
}

mod = {
  name: "Any Raise",
  description: "Secret poker: raise any amount between the minimum raise and all-in. "
    + "-/+ or the mouse wheel set the amount (Shift for bigger steps), P for a pot-sized raise, 6 to raise.",

  amount: 0,
  was_turn: false,
  hold: 0,

  draw_end: fun () {
    let pc = arz_poker()
    if (is_undefined(pc)) {
      mod.was_turn = false
      return
    }
    let r = arz_range(pc)
    if (is_undefined(r)) {
      mod.was_turn = false
      mod.hold = 0
      return
    }
    -- A fresh decision: start one step above the game's bigger raise.
    if (!mod.was_turn) {
      mod.was_turn = true
      mod.amount = r.start
    }
    mod.amount = arz_snap(mod.amount, r)

    let free = !instance_exists(o_window) and !instance_exists(o_vn)

    -- Keyboard / wheel, read in Draw like the game's own 1-5 hotkeys.
    if (free) {
      if (mouse_wheel_up()) {
        arz_nudge(r, 1)
      } else if (mouse_wheel_down()) {
        arz_nudge(r, -1)
      }
      if (keyboard_check_pressed(ARZ_KEY_POT)) {
        mod.amount = arz_snap(r.pot, r)
      }
      let plus = arz_any_down(ARZ_KEY_PLUS)
      let minus = arz_any_down(ARZ_KEY_MINUS)
      if (plus != minus) {
        mod.hold += 1
        let h = mod.hold
        if (h == 1 or (h > 20 and (h - floor(h / 3) * 3) == 0)) {
          if (plus) {
            arz_nudge(r, 1)
          } else {
            arz_nudge(r, -1)
          }
        }
      } else {
        mod.hold = 0
      }
      if (arz_any_pressed(ARZ_KEY_GO)) {
        arz_commit(r)
        return
      }
    }

    -- Controls sit in the free band above the Pot readout, right of your cards.
    let old_col = draw_get_colour()
    let old_alpha = draw_get_alpha()
    let old_font = draw_get_font()
    let old_ha = draw_get_halign()
    let old_va = draw_get_valign()
    draw_set_font(global.font)
    draw_set_alpha(1)

    let rh = room_height_get()
    let y1 = rh - 56
    let y2 = rh - 44
    let x0 = 290
    let tip = "-/+ or mouse wheel: change amount (Shift: x10). P: pot. 6: raise."

    let at_lo = 0
    if (mod.amount <= r.lo) {
      at_lo = 1
    }
    let at_cap = 0
    if (mod.amount >= r.cap) {
      at_cap = 1
    }
    if (draw_button_my(x0, y1, x0 + 14, y2, "-", Pusto, 0, 0, at_lo, "", 1, 0, 0, tip)) {
      arz_nudge(r, -1)
    }
    let go = draw_button_my(x0 + 18, y1, x0 + 122, y2, "6. " + arz_label(r), Pusto, 0, 1, 0, "", 1, 0, 0, tip, global.color3, 1, 1, 1)
    if (draw_button_my(x0 + 126, y1, x0 + 140, y2, "+", Pusto, 0, 0, at_cap, "", 1, 0, 0, tip)) {
      arz_nudge(r, 1)
    }
    if (draw_button_my(x0 + 144, y1, x0 + 172, y2, "Pot", Pusto, 0, 1, 0, "", 1, 0, 0, "Pot-sized raise (" + string(arz_snap(r.pot, r)) + ")")) {
      mod.amount = arz_snap(r.pot, r)
    }

    draw_set_colour(old_col)
    draw_set_alpha(old_alpha)
    draw_set_font(old_font)
    draw_set_halign(old_ha)
    draw_set_valign(old_va)

    if (go) {
      arz_commit(r)
    }
  }
}
return mod
